# build artefacts of the Rust tooling
target/
**/target/

# Python bytecode (legacy tooling copies kept as port evidence)
__pycache__/
*.pyc

# LaTeX intermediates (main.pdf is committed on purpose)
*.aux
*.log
*.blg
*.bbl
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# bundled TeX engine: not part of the paper, fetched on demand
tools/tectonic
tools/tectonic-*.zip

# editor / OS noise
.DS_Store
Thumbs.db

# Vendored subjects of the audit packages: each package pins its own commit in
# experiments/subjects.lock and clones it with scripts/fetch_subjects.sh.
subjects/
*/subjects/

# Downloaded toolchain binaries
tooling/tectonic/
tooling/*.zip
